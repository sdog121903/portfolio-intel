__pycache__/
*.pyc
.DS_Store
# Price CSVs are re-downloaded every run; metrics, filings and research snapshots are kept.
data/prices/*.csv
# Secrets never belong in the repository; keys live in the cloud environment.
.env
.env.*
*.pem
*.key
# Local Python environment created by scripts/bootstrap.sh
.venv/
# Personal output stays on this computer (the repository shares only the tool)
reports/daily/*/
reports/deep-dives/*-20*.md
reports/pdf/*.pdf
learning/lessons/20*.md
data/*/*
!data/*/.gitkeep
# Each stock's news log is personal history: the record lives in data/news-log/, the pages here
theses/news/*.md
!theses/news/README.md
